@model RealStateApp.Core.Application.ViewModels.Admin.AgentListViewModel

@{
    ViewData["Title"] = "Eliminar Agente";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">
                    <div class="mb-4 text-danger">
                        <i class="fa-solid fa-triangle-exclamation fa-3x"></i>
                    </div>

                    <h3 class="fw-bold mb-3">Confirmar Eliminación</h3>

                    <p class="text-muted mb-4">
                        ¿Está seguro que desea eliminar este agente y todas sus propiedades? <br />
                        <strong>@Model.Nombre @Model.Apellido</strong> (@Model.Email)
                    </p>

                    <form asp-action="EliminarAgente" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Agentes" class="btn btn-secondary px-4 fw-bold">Cancelar</a>
                            <button type="submit" class="btn btn-danger px-4 fw-bold">Aceptar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>