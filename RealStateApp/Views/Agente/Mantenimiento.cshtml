@model IEnumerable<RealStateApp.Core.Application.DTOs.Propiedades.PropiedadDTO>

@{
    ViewData["Title"] = "Mantenimiento de Mis Propiedades";
}

<div class="container mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h2 class="fw-bold text-dark">Mantenimiento de Mis Propiedades</h2>
            <p class="text-muted">Consulta, crea, edita o elimina las propiedades registradas en tu cuenta.</p>
        </div>
        <div class="col text-end">
            <a asp-action="Crear" class="btn btn-primary fw-bold">
                <i class="fa-solid fa-plus me-1"></i> Crear propiedad
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Imagen</th>
                            <th>Código</th>
                            <th>Tipo</th>
                            <th>Precio</th>
                            <th class="text-center">Hab / Baños</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (item.ImagenesUrls != null && item.ImagenesUrls.Any())
                                        {
                                            <img src="@item.ImagenesUrls.First()" width="60" height="45" style="object-fit: cover;" class="rounded shadow-sm" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sin imagen</span>
                                        }
                                    </td>
                                    <td><strong>@item.Codigo</strong></td>
                                    <td>@item.TipoPropiedadNombre</td>
                                    <td class="fw-semibold">RD$ @item.Precio.ToString("N2")</td>
                                    <td class="text-center">@item.CantidadHabitaciones hab / @item.CantidadBanos baños</td>
                                    <td class="text-end">
                                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                            <i class="fa-solid fa-pen-to-square"></i> Editar
                                        </a>

                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                onclick="prepararEliminacion(@item.Id)"
                                                title="Eliminar">
                                            <i class="fa-solid fa-trash"></i> Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No tiene propiedades disponibles registradas en este momento.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary px-4 fw-bold">Volver al Home</a>
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="modalEliminarPropiedad" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalEliminarLabel">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3 text-danger">
                    <i class="fa-solid fa-triangle-exclamation fa-3x"></i>
                </div>
                <p class="fs-6 text-muted mb-0">¿Está seguro que desea eliminar esta propiedad?</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminarPropiedad" method="post" asp-action="Eliminar">
                    <input type="hidden" id="propiedadIdInput" name="id" />
                    <button type="submit" class="btn btn-danger px-4 fw-bold">Aceptar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepararEliminacion(id) {
            const modal = new bootstrap.Modal(document.getElementById('modalEliminarPropiedad'));
            document.getElementById('propiedadIdInput').value = id;
            modal.show();
        }
    </script>
}