@model RealStateApp.Core.Domain.Entities.ApplicationUser

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Mi Perfil</h2>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm p-4 text-center">
        <!-- Contenedor de la foto de perfil -->
        <div class="mb-4">
            <img src="@(string.IsNullOrEmpty(Model.FotoPerfilUrl) ? "/images/default-user.png" : Model.FotoPerfilUrl)"
                 alt="Foto de perfil"
                 class="rounded-circle img-thumbnail shadow-sm"
                 style="width: 130px; height: 130px; object-fit: cover;" />
        </div>

        <div class="text-start">
            <div class="mb-3">
                <label class="form-label fw-bold">Nombre:</label>
                <p class="form-control-static">@Model.Nombre</p>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Apellido:</label>
                <p class="form-control-static">@Model.Apellido</p>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Teléfono:</label>
                <p class="form-control-static">@Model.PhoneNumber</p>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Correo electrónico:</label>
                <p class="form-control-static">@Model.Email</p>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Panel" class="btn btn-secondary">Volver al Panel</a>
            <a asp-action="EditarPerfil" class="btn btn-primary">Editar Perfil</a>
        </div>
    </div>
</div>