<!-- SECCIÓN DE CHAT CON EL AGENTE -->
<div class="card mt-4 shadow-sm border-0">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="bi bi-chat-text me-2"></i>Conversación con el Agente</h5>
    </div>

    <!-- Historial de Mensajes -->
    <div class="card-body bg-light" style="max-height: 400px; overflow-y: auto;" id="seccionChat">
        @if (Model.Mensajes == null || !Model.Mensajes.Any())
        {
            <div class="text-center text-muted my-4">
                <i class="bi bi-envelope-open fs-3 d-block mb-2"></i>
                No hay mensajes en esta conversación. ¡Escribe el primero!
            </div>
        }
        else
        {
            // Solución al error de FindFirstValue
            var clienteActualId = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            @foreach (var msg in Model.Mensajes)
            {
                var esMio = msg.EmisorId == clienteActualId;
                <div class="d-flex mb-3 @(esMio ? "justify-content-end" : "justify-content-start")">
                    <div class="p-3 rounded-3 shadow-sm @(esMio ? "bg-primary text-white" : "bg-white text-dark border")" style="max-width: 80%;">
                        <div class="small fw-bold mb-1 opacity-75">
                            <!-- Ajustado a tu MensajeDTO -->
                            @(esMio ? "Tú" : msg.AgenteNombre ?? "Agente")
                        </div>
                        <div>@msg.Contenido</div>
                        <div class="text-end mt-1" style="font-size: 0.75rem; opacity: 0.8;">
                            <!-- Ajustado a tu MensajeDTO -->
                            @msg.FechaEnvio.ToString("dd/MM/yyyy hh:mm tt")
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Formulario de Envío validando el estado de la propiedad -->
    @if (Model.Estado == "Disponible") // Validación requerida
    {
        <div class="card-footer bg-white">
            <form asp-controller="Mensaje" asp-action="Enviar" method="post">
                <input type="hidden" name="PropiedadId" value="@Model.Id" />
                <input type="hidden" name="AgenteId" value="@Model.AgenteId" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                <div class="input-group">
                    <!-- Validación HTML5 con el mensaje de error exacto del documento -->
                    <input type="text"
                           name="Contenido"
                           class="form-control"
                           placeholder="Escribe tu mensaje aquí..."
                           required
                           oninvalid="this.setCustomValidity('Debe escribir un mensaje antes de enviarlo.')"
                           oninput="this.setCustomValidity('')" />

                    <button type="submit" class="btn btn-primary">
                        Enviar mensaje
                    </button>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="card-footer bg-white text-center">
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i> Esta propiedad ya no se encuentra disponible. No se pueden enviar mensajes.
            </div>
        </div>
    }
</div>

<!-- Script para mantener el scroll del chat abajo -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var chatBox = document.getElementById('seccionChat');
        if(chatBox) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    });
</script>