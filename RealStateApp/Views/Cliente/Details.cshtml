@model RealStateApp.Core.Application.ViewModels.Cliente.ClientePropiedadDetailViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Detalles de la Propiedad";

    // Forma segura de obtener el Claim sin requerir métodos de extensión adicionales
    string currentUserId = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value ?? "";

    // Lógica para habilitar/deshabilitar el botón de ofertas
    bool puedeOfertar = Model.Propiedad.Estado == "Disponible"
                     && !Model.TieneOfertaAceptadaGlobal
                     && !Model.TieneOfertaPendiente;
}

<div class="container my-4">
    <!-- Alertas de TempData (Éxito o Error) -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- SECCIÓN IZQUIERDA: DETALLES DE LA PROPIEDAD -->
        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@Model.Propiedad.Codigo</h4>
                    <span class="badge bg-light text-dark fs-6">@Model.Propiedad.Estado</span>
                </div>
                <div class="card-body">
                    <h3 class="card-title text-success fw-bold">RD$ @Model.Propiedad.Precio.ToString("N2")</h3>
                    <p class="text-muted"><i class="bi bi-geo-alt-fill text-danger"></i> Propiedad en venta</p>

                    <hr />
                    <h5>Descripción</h5>
                    <p>@Model.Propiedad.Descripcion</p>

                    <div class="row mt-4">
                        <div class="col-6 mb-3">
                            <strong><i class="bi bi-house-door"></i> Tipo:</strong> @Model.Propiedad.TipoPropiedadNombre
                        </div>
                        <div class="col-6 mb-3">
                            <strong><i class="bi bi-tag"></i> Venta:</strong> @Model.Propiedad.TipoVentaNombre
                        </div>
                        <div class="col-6 mb-3">
                            <strong><i class="bi bi-door-open"></i> Habitaciones:</strong> @Model.Propiedad.CantidadHabitaciones
                        </div>
                        <div class="col-6 mb-3">
                            <strong><i class="bi bi-droplet"></i> Baños:</strong> @Model.Propiedad.CantidadBanos
                        </div>
                        <div class="col-6 mb-3">
                            <strong><i class="bi bi-arrows-fullscreen"></i> Tamaño:</strong> @Model.Propiedad.Tamano m²
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN: OFERTAS DEL CLIENTE -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Mis Ofertas</h5>

                    @if (puedeOfertar)
                    {
                        <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#modalOferta">
                            Enviar nueva oferta
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-secondary" disabled>
                            Enviar nueva oferta
                        </button>
                    }
                </div>
                <div class="card-body">
                    <!-- Mensajes de validación de ofertas requeridos por el documento -->
                    @if (!puedeOfertar)
                    {
                        <div class="alert alert-warning mb-3 small">
                            @if (Model.Propiedad.Estado != "Disponible")
                            {
                                <span>Esta propiedad ya no se encuentra disponible para recibir ofertas.</span>
                            }
                            else if (Model.TieneOfertaAceptadaGlobal)
                            {
                                <span>Esta propiedad ya tiene una oferta aceptada y no permite nuevas ofertas.</span>
                            }
                            else if (Model.TieneOfertaPendiente)
                            {
                                <span>Ya tiene una oferta pendiente para esta propiedad.</span>
                            }
                        </div>
                    }

                    @if (!Model.Ofertas.Any())
                    {
                        <p class="text-muted text-center my-3">No has realizado ninguna oferta por esta propiedad.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Monto Ofertado</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var oferta in Model.Ofertas)
                                    {
                                        <tr>
                                            <td>@oferta.FechaOferta.ToString("dd/MM/yyyy")</td>
                                            <td class="fw-bold text-success">RD$ @oferta.Monto.ToString("N2")</td>
                                            <td>
                                                @if (oferta.Estado == "Pendiente")
                                                {
                                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                                }
                                                else if (oferta.Estado == "Aceptada")
                                                {
                                                    <span class="badge bg-success">Aceptada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Rechazada</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SECCIÓN DERECHA: CHAT CON EL AGENTE -->
        <div class="col-md-5">
            <div class="card shadow-sm h-100 d-flex flex-column">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-chat-dots me-2"></i>Chat con el Agente</h5>
                </div>

                <!-- Historial de mensajes -->
                <div class="card-body bg-light flex-grow-1" id="chatBox" style="max-height: 500px; overflow-y: auto;">
                    @if (!Model.Mensajes.Any())
                    {
                        <div class="text-center text-muted mt-5">
                            <i class="bi bi-envelope-paper display-4 d-block mb-3"></i>
                            <p>No hay mensajes. ¡Envía tu primera consulta!</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in Model.Mensajes)
                        {
                            bool esMio = msg.EmisorId == currentUserId;
                            <div class="d-flex mb-3 @(esMio ? "justify-content-end" : "justify-content-start")">
                                <div class="p-3 rounded-3 shadow-sm @(esMio ? "bg-primary text-white" : "bg-white border")" style="max-width: 85%;">
                                    <div class="small fw-bold mb-1 opacity-75">
                                        @(esMio ? "Tú" : "Agente")
                                    </div>
                                    <div>@msg.Contenido</div>
                                    <div class="text-end mt-1" style="font-size: 0.75rem; opacity: 0.8;">
                                        @msg.FechaEnvio.ToString("hh:mm tt")
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Formulario de envío de mensajes -->
                @if (Model.Propiedad.Estado == "Disponible")
                {
                    <div class="card-footer bg-white border-top-0">
                        <form asp-action="EnviarMensaje" method="post">
                            <input type="hidden" name="propiedadId" value="@Model.Propiedad.Id" />

                            <div class="input-group">
                                <input type="text" name="mensajeTexto" class="form-control" placeholder="Escribe un mensaje..." required
                                       oninvalid="this.setCustomValidity('Debe escribir un mensaje antes de enviarlo.')"
                                       oninput="this.setCustomValidity('')" />
                                <button class="btn btn-primary" type="submit">Enviar</button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="card-footer bg-light text-center text-muted">
                        <small>La propiedad ya no está disponible. Chat deshabilitado.</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA NUEVA OFERTA -->
<div class="modal fade" id="modalOferta" tabindex="-1" aria-labelledby="modalOfertaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalOfertaLabel"><i class="bi bi-cash me-2"></i>Enviar Oferta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EnviarOferta" method="post">
                <div class="modal-body">
                    <input type="hidden" name="propiedadId" value="@Model.Propiedad.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Precio de la propiedad</label>
                        <input type="text" class="form-control" value="RD$ @Model.Propiedad.Precio.ToString("N2")" disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Monto Ofertado</label>
                        <div class="input-group">
                            <span class="input-group-text">RD$</span>
                            <input type="number" step="0.01" name="montoOferta" class="form-control" placeholder="Ej. 1500000" required
                                   oninvalid="this.setCustomValidity('Debe ingresar el monto de la oferta.')"
                                   oninput="this.setCustomValidity('')" />
                        </div>
                        <div class="form-text text-muted">El monto debe ser numérico y mayor a cero.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Enviar oferta</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mantener el scroll del chat siempre abajo al cargar la página
        document.addEventListener("DOMContentLoaded", function() {
            var chatBox = document.getElementById('chatBox');
            if(chatBox) {
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        });
    </script>
}