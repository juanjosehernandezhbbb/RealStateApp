@model RealStateApp.Core.Application.ViewModels.Cliente.ClientePropiedadDetailViewModel

@{
    ViewData["Title"] = "Detalle de Propiedad";
    bool estaDisponible = Model.Propiedad.Estado == "Disponible";
}

<div class="container mt-4 pb-5">
    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Columna Izquierda: Información, Galería, Mejoras, Chat y Ofertas -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2>@Model.Propiedad.TipoPropiedadNombre - @Model.Propiedad.TipoVentaNombre</h2>
                <span class="badge @(estaDisponible ? "bg-success" : "bg-secondary") fs-6">@Model.Propiedad.Estado</span>
            </div>
            <p class="text-muted"><i class="fa-solid fa-code"></i> Código: <strong>@Model.Propiedad.Codigo</strong></p>

            <!-- Carrusel de Imágenes -->
            @if (Model.Propiedad.ImagenesUrls != null && Model.Propiedad.ImagenesUrls.Any())
            {
                <div id="propertyCarousel" class="carousel slide mb-4 shadow-sm rounded overflow-hidden" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.Propiedad.ImagenesUrls.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.Propiedad.ImagenesUrls[i]" class="d-block w-100" style="height: 400px; object-fit: cover;" alt="Imagen de la propiedad">
                            </div>
                        }
                    </div>
                    @if (Model.Propiedad.ImagenesUrls.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    }
                </div>
            }

            <!-- Descripción -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h4><i class="fa-solid fa-align-left text-primary me-2"></i>Descripción</h4>
                    <p class="mb-0">@Model.Propiedad.Descripcion</p>
                </div>
            </div>

            <!-- Características -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h4><i class="fa-solid fa-list-check text-primary me-2"></i>Características</h4>
                    <ul class="list-group list-group-flush mt-3">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-dollar-sign text-muted me-2"></i>Precio</span>
                            <strong>$ @Model.Propiedad.Precio.ToString("N2")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-ruler-combined text-muted me-2"></i>Tamaño</span>
                            <strong>@Model.Propiedad.Tamano m²</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-bed text-muted me-2"></i>Habitaciones</span>
                            <strong>@Model.Propiedad.CantidadHabitaciones</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-bath text-muted me-2"></i>Baños</span>
                            <strong>@Model.Propiedad.CantidadBanos</strong>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Mejoras -->
            @if (Model.Propiedad.Mejoras != null && Model.Propiedad.Mejoras.Any())
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <h4><i class="fa-solid fa-star text-warning me-2"></i>Mejoras y Características Adicionales</h4>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var mejora in Model.Propiedad.Mejoras)
                            {
                                <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-check text-success me-1"></i> @mejora</span>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Sección de Chat -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0"><i class="fa-solid fa-comments text-success me-2"></i>Chat con el Agente</h4>
                </div>
                <div class="card-body">
                    @if (!estaDisponible)
                    {
                        <div class="alert alert-warning mb-3">La propiedad ya no está disponible, por lo que el chat se encuentra deshabilitado para nuevos mensajes.</div>
                    }

                    <!-- Historial de Mensajes -->
                    <div class="border rounded p-3 mb-3 bg-light" style="max-height: 350px; overflow-y: auto;">
                        @if (Model.Mensajes != null && Model.Mensajes.Any())
                        {
                            @foreach (var msg in Model.Mensajes)
                            {
                                bool esCliente = msg.EmisorId == msg.ClienteId;
                                <div class="mb-3 d-flex flex-column @(esCliente ? "align-items-end" : "align-items-start")">
                                    <div class="p-3 rounded shadow-sm @(esCliente ? "bg-primary text-white" : "bg-white border")" style="max-width: 75%;">
                                        <p class="mb-1">@msg.Contenido</p>
                                        <small class="@(esCliente ? "text-white-50" : "text-muted")" style="font-size: 0.75rem;">@msg.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">No hay mensajes en esta conversación todavía. ¡Escribe el primero!</p>
                        }
                    </div>

                    <!-- Formulario de Envío de Mensaje -->
                    @if (estaDisponible)
                    {
                        <form asp-controller="Cliente" asp-action="EnviarMensaje" method="post">
                            <input type="hidden" name="propiedadId" value="@Model.Propiedad.Id" />
                            <div class="input-group">
                                <input type="text" name="mensajeTexto" class="form-control" placeholder="Escribe tu mensaje al agente..." required />
                                <button type="submit" class="btn btn-success"><i class="fa-solid fa-paper-plane me-1"></i> Enviar mensaje</button>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <!-- Sección de Ofertas Realizadas -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fa-solid fa-hand-holding-dollar text-primary me-2"></i>Mis Ofertas</h4>

                    @{
                        bool tienePendiente = Model.TieneOfertaPendiente;
                        bool tieneAceptadaGlobal = Model.TieneOfertaAceptadaGlobal;
                        bool puedeOfertar = estaDisponible && !tienePendiente && !tieneAceptadaGlobal;
                    }

                    @if (puedeOfertar)
                    {
                        <button type="button" class="btn btn-primary btn-sm fw-bold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalOferta">
                            <i class="fa-solid fa-plus me-1"></i> Enviar nueva oferta
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary btn-sm fw-bold rounded-pill px-3" disabled title="No disponible para ofertar">
                            Enviar nueva oferta
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (!estaDisponible)
                    {
                        <div class="alert alert-danger mb-3">Esta propiedad ya no se encuentra disponible para recibir ofertas.</div>
                    }
                    else if (tieneAceptadaGlobal)
                    {
                        <div class="alert alert-warning mb-3">Esta propiedad ya tiene una oferta aceptada y no permite nuevas ofertas.</div>
                    }
                    else if (tienePendiente)
                    {
                        <div class="alert alert-info mb-3">Ya tiene una oferta pendiente para esta propiedad.</div>
                    }

                    <!-- Listado de Ofertas -->
                    @if (Model.Ofertas != null && Model.Ofertas.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha y Hora</th>
                                        <th>Monto Ofertado</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var oferta in Model.Ofertas)
                                    {
                                        string badgeClass = oferta.Estado switch
                                        {
                                            "Pendiente" => "bg-warning text-dark",
                                            "Aceptada" => "bg-success",
                                            "Rechazada" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        <tr>
                                            <td>@oferta.FechaOferta.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><strong>$ @oferta.Monto.ToString("N2")</strong></td>
                                            <td><span class="badge @badgeClass">@oferta.Estado</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">Aún no has realizado ninguna oferta para esta propiedad.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Tarjeta del Agente Responsable (Incluye Nombre, Foto, Teléfono y Correo) -->
        <div class="col-md-4">
            <div class="card shadow-sm sticky-top" style="top: 2rem;">
                <div class="card-body text-center">
                    <h4 class="mb-3">Agente Responsable</h4>

                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.Propiedad.AgenteFotoPerfilUrl))
                        {
                            <img src="@Model.Propiedad.AgenteFotoPerfilUrl" class="rounded-circle shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" alt="Foto del Agente" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 100px; height: 100px; font-size: 2.5rem;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                        }
                    </div>

                    <!-- Nombre del Agente -->
                    <h5 class="fw-bold mb-1">@Model.Propiedad.AgenteNombre</h5>
                    <p class="text-muted small mb-3">Agente Inmobiliario Autorizado</p>

                    <hr class="my-3">

                    <div class="text-start px-2">
                        <!-- Teléfono del Agente -->
                        <p class="mb-2 text-muted small">
                            <i class="fa-solid fa-phone text-primary me-2"></i> <strong>Teléfono:</strong> @Model.Propiedad.AgenteTelefono
                        </p>
                        <!-- Correo del Agente -->
                        <p class="mb-3 text-muted small">
                            <i class="fa-solid fa-envelope text-primary me-2"></i> <strong>Correo:</strong> @Model.Propiedad.AgenteEmail
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Enviar Nueva Oferta -->
@if (puedeOfertar)
{
    <div class="modal fade" id="modalOferta" tabindex="-1" aria-labelledby="modalOfertaLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Cliente" asp-action="EnviarOferta" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalOfertaLabel">Hacer una Oferta</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="propiedadId" value="@Model.Propiedad.Id" />
                        <div class="mb-3">
                            <label for="montoOferta" class="form-label">Monto ofertado *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" min="1" class="form-control" id="montoOferta" name="montoOferta" placeholder="Ej. 150000" required />
                            </div>
                            <div class="form-text">Ingrese un valor numérico mayor que cero.</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Enviar oferta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}