@model IEnumerable<RealStateApp.Core.Application.DTOs.Usuarios.UsuarioDTO>
@{
    ViewData["Title"] = "Agentes Inmobiliarios";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold text-dark">Agentes Inmobiliarios</h2>
            <p class="text-muted">Conoce a nuestros agentes activos y encuentra las mejores propiedades.</p>
        </div>
    </div>

    <!-- Formulario de Búsqueda -->
    <form method="get" asp-action="Agentes" class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="input-group shadow-sm">
                <input type="text" name="nombreFiltro" class="form-control" placeholder="Buscar agente por nombre o apellido..." value="@ViewBag.NombreFiltro">
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i> Buscar
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.NombreFiltro as string))
                {
                    <a asp-action="Agentes" class="btn btn-outline-secondary">Limpiar</a>
                }
            </div>
        </div>
    </form>

    <!-- Listado de Agentes -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm py-4" role="alert">
            <h4 class="alert-heading">No se encontraron agentes</h4>
            <p class="mb-0">No hay agentes activos registrados o que coincidan con tu búsqueda en este momento.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var agente in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body text-center p-4 d-flex flex-column">
                            <!-- Foto de Perfil o Inicial -->
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(agente.FotoPerfilUrl))
                                {
                                    <img src="@agente.FotoPerfilUrl" alt="@agente.Nombre" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">
                                        @(string.IsNullOrEmpty(agente.Nombre) ? "A" : agente.Nombre.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-1">@agente.Nombre @agente.Apellido</h5>

                            <p class="text-muted small mb-3">
                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Agente Activo</span>
                            </p>

                            <hr class="text-muted opacity-25">

                            <div class="text-start small text-secondary mb-4">
                                <p class="mb-2"><i class="bi bi-envelope-fill text-primary me-2"></i> <strong>Correo:</strong> @agente.Email</p>
                                <p class="mb-0"><i class="bi bi-telephone-fill text-primary me-2"></i> <strong>Teléfono:</strong> @(string.IsNullOrEmpty(agente.Telefono) ? "No registrado" : agente.Telefono)</p>
                            </div>

                            <!-- Botón para ver propiedades -->
                            <div class="mt-auto">
                                <a asp-controller="Home" asp-action="PropiedadesPorAgente" asp-route-id="@agente.Id" class="btn btn-outline-primary w-100 fw-semibold">
                                    Ver Propiedades
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>