@model IEnumerable<RealStateApp.Core.Application.DTOs.Propiedades.PropiedadDTO>
@{
    ViewData["Title"] = "Mis Propiedades Favoritas";
}

<div class="container my-4">
    <div class="row mb-3">
        <div class="col">
            <h2>Mis Propiedades Favoritas</h2>
            <p class="text-muted">Aquí encontrarás todas las propiedades que has guardado en tu lista de favoritos.</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center py-4">
            <h4>Aún no tienes favoritos</h4>
            <p class="mb-0">Explora las propiedades disponibles y haz clic en el botón de favorito para guardarlas aquí.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <img src="@(item.ImagenesUrls != null && item.ImagenesUrls.Any() ? item.ImagenesUrls.First() : "/images/no-image.png")"
                             class="card-img-top" style="height: 200px; object-fit: cover;" alt="Propiedad">

                        <span class="position-absolute top-0 end-0 badge bg-success m-2 px-3 py-2">@item.TipoVentaNombre</span>

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-primary fw-bold mb-0">@item.TipoPropiedadNombre</h5>
                                <small class="text-muted fw-semibold">Cód: @item.Codigo</small>
                            </div>

                            <h4 class="text-dark fw-bold mb-3">RD$ @item.Precio.ToString("N2")</h4>

                            <div class="row text-muted small mb-3 g-1">
                                <div class="col-4"><i class="fa-solid fa-bed"></i> @item.CantidadHabitaciones habs</div>
                                <div class="col-4"><i class="fa-solid fa-bath"></i> @item.CantidadBanos baños</div>
                                <div class="col-4"><i class="fa-solid fa-ruler-combined"></i> @item.Tamano m²</div>
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-50 fw-semibold">
                                    Ver Detalle
                                </a>

                                <form asp-action="ToggleFavorito" asp-route-propiedadId="@item.Id" asp-route-returnUrl="@Context.Request.Path" method="post" class="w-50 m-0">
                                    <button type="submit" class="btn btn-danger btn-sm w-100 fw-semibold" title="Quitar de favoritos">
                                        <i class="fa-solid fa-heart-broken"></i> Quitar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>