@model RealStateApp.Core.Application.DTOs.Usuarios.SaveUsuarioDTO

@{
    ViewData["Title"] = "Únete a la app";
}

<div class="container my-5" style="max-width: 750px;">
    <div class="card shadow-sm border-0 p-4">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Únete a RealEstateApp</h2>
            <p class="text-muted">Crea tu cuenta seleccionando tu tipo de usuario.</p>
        </div>

        <form asp-action="Register" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre *</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Juan" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Apellido" class="form-label fw-semibold">Apellido *</label>
                    <input asp-for="Apellido" class="form-control" placeholder="Ej. Pérez" />
                    <span asp-validation-for="Apellido" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Telefono" class="form-label fw-semibold">Teléfono *</label>
                    <input asp-for="Telefono" class="form-control" placeholder="Ej. 8090000000" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Rol" class="form-label fw-semibold">Tipo de usuario *</label>
                    <select asp-for="Rol" class="form-select">
                        <option value="">Seleccione un rol...</option>
                        <option value="Cliente">Cliente</option>
                        <option value="Agente">Agente</option>
                    </select>
                    <span asp-validation-for="Rol" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label fw-semibold">Nombre de usuario *</label>
                    <input asp-for="UserName" class="form-control" placeholder="Ej. jperez" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold">Correo electrónico *</label>
                    <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold">Contraseña *</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmar contraseña *</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="File" class="form-label fw-semibold">Foto de usuario *</label>
                    <input asp-for="File" class="form-control" type="file" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="File" class="text-danger small"></span>
                    <div class="form-text">Formatos permitidos: .jpg, .jpeg, .png</div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver a la pantalla inicial</a>
                <button type="submit" class="btn btn-primary px-4 fw-semibold">Registrarse</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}